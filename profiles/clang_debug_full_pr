[settings]
arch=x86_64
build_type=Debug
compiler=clang
compiler.cppstd=23
compiler.libcxx=libstdc++11
compiler.version=22
os=Linux

[conf]
tools.build:cxxflags+=["-Wno-register"]
tools.build:skip_test=True
tools.build:jobs=8
tools.cmake.cmaketoolchain:generator=Ninja

[buildenv]
CC=clang-22
CXX=clang++-22

[build_profile]
arch=x86_64
build_type=Release
compiler=gcc
compiler.cppstd=gnu17
compiler.libcxx=libstdc++11
compiler.version=16.0
os=Linux
[conf]
tools.build:jobs=8
[buildenv]
CC=gcc
CXX=g++
